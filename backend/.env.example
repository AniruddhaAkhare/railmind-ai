# Flask
FLASK_ENV=development
FLASK_DEBUG=True

# Database
DATABASE_URL=postgresql://railmind:railmind@localhost:5432/railmind_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenRouter LLM
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=meta-llama/llama-2-7b-chat

# Application
APP_NAME=RailMind AI
APP_VERSION=1.0.0

# Features
ENABLE_SYNTHETIC_DATA=True
ENABLE_SIMULATION=True
ENABLE_AGENTS=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=/tmp/railmind.log

# RailRadar API & Hybrid Integration
RAILRADAR_API_KEY=
RAIL_DATA_MODE=hybrid
RAILRADAR_POLL_INTERVAL_SECONDS=300
RAILRADAR_REQUEST_TIMEOUT_SECONDS=15
RAILRADAR_MAX_CONCURRENT_REQUESTS=5
LIVE_TRAIN_AFFECT_RADIUS_KM=25